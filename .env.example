# ============================================================
# Phase 1 — English + Hindi hosted/free-tier prototype
# ============================================================
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Language policy
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi

# Groq: ONE key is used by both STT and LLM.
# Create it in the Groq Console -> API Keys.
GROQ_API_KEY=replace_me
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=qwen/qwen3.6-27b
GROQ_LLM_REASONING_EFFORT=none

# Provider switches
STT_PROVIDER=groq
LLM_PROVIDER=groq
TTS_PROVIDER=edge

# Local multilingual RAG
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_COLLECTION=knowledge
RAG_TOP_K=5
RAG_MIN_SCORE=0.20
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# edge-tts voices. Verify current availability with: edge-tts --list-voices
EDGE_TTS_VOICE_EN=en-IN-NeerjaNeural
EDGE_TTS_VOICE_HI=hi-IN-SwaraNeural

# ============================================================
# Phase 2 — self-hosted provider endpoints
# ============================================================
# Optional/Phase 2: required if a gated Hugging Face model needs authentication.
HF_TOKEN=
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_API_KEY=local-not-secret
LOCAL_LLM_MODEL=qwen-domain
LOCAL_ASR_URL=http://localhost:8002/transcribe
LOCAL_TTS_URL=http://localhost:8003/synthesize
LOCAL_TTS_VOICE_EN=Thoma
LOCAL_TTS_VOICE_HI=Divya

# Frontend (copy separately to frontend/.env.local if desired)
VITE_API_BASE_URL=http://localhost:8000
